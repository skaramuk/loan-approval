# Copy to .env.local. All three values are public (they are shipped to the browser).
# Never put the database connection string or a Supabase secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
