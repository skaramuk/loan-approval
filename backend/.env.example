# Copy to .env for local development. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Model package to serve (backend/app/ml_artifacts/v<MODEL_VERSION>/)
MODEL_VERSION=1.0.0

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Supabase project URL (public). Access tokens are verified against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json, so no JWT secret is needed.
SUPABASE_URL=https://your-project-ref.supabase.co

# SECRET. Server-side Postgres connection string; never give it to the frontend.
# Supabase dashboard -> Connect -> "Session pooler" (port 5432, works on IPv4 networks).
# Do not use the transaction pooler (port 6543) here: it does not support prepared statements.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Per-user limit on POST /api/v1/predictions
PREDICTION_RATE_LIMIT=20/minute
